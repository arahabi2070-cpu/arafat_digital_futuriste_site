# ============================================================
# ADF — Site vitrine : variables d'environnement (NOMS seulement)
# Les valeurs vivent dans le tableau de bord Vercel du projet,
# jamais dans le code ni dans un document.
# ============================================================

# Mot de passe UNIQUE de l'administration (/admin) — la même
# valeur que ADMIN_API_KEY de la boutique : un seul secret à
# retenir. Elle garde aussi le pont de compteurs (/api/compteurs)
# et authentifie les appels de notification vers la boutique.
ADMIN_API_KEY=

# Base Postgres des avis services et des messages de contact
# (Phase 2) — injectées automatiquement par Vercel quand la base
# Neon est créée et reliée au projet. Sans elles, le site
# fonctionne exactement comme avant (avis et archivage inactifs,
# en douceur). POSTGRES_URL est acceptée comme alias.
DATABASE_URL=
POSTGRES_URL=

# Jeton du store Vercel Blob du portfolio (injecté par Vercel
# quand le store est relié au projet).
BLOB_READ_WRITE_TOKEN=

# URL publique de la boutique : source du flux catalogue de la
# section « Boutique » (étape 3b) et destination des appels de
# notification poussée (Phase 4). Défaut dans le code :
# https://adf-store.vercel.app
BOUTIQUE_URL=
